# Set seeds for reproducibility
def set_seed(seed: int = 42):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)
    torch.backends.cudnn.deterministic = False
    torch.backends.cudnn.benchmark = True


@dataclass
class CFG:
    # Data
    data_dir: str = '/kaggle/input/cucumber-disease-dataset'  # set your Kaggle dataset path
    csv_path: Optional[str] = None  # if using CSV with columns [image_path,label]
    output_dir: str = './outputs'
    img_size: int = 224
    num_workers: int = 2
    valid_size: float = 0.2
    seed: int = 42

    # Train
    epochs: int = 25
    batch_size: int = 32
    lr: float = 2e-4
    weight_decay: float = 1e-4
    label_smoothing: float = 0.05
    use_pretrained: bool = True
    freeze_backbone_epochs: int = 0
    dropout: float = 0.3
    grad_clip_norm: float = 1.0
    accumulate_steps: int = 1

    # Mixup/CutMix
    mixup_alpha: float = 0.2
    cutmix_alpha: float = 0.8
    mixup_prob: float = 0.5
    cutmix_prob: float = 0.3

    # Scheduler
    use_one_cycle: bool = True
    max_lr: float = 2e-4
    pct_start: float = 0.3

    # Early stopping
    es_patience: int = 6

    # Model
    backbone_a: str = 'resnet50'
    backbone_b: str = 'efficientnet_b0'


# Ensure output dir
os.makedirs(CFG.output_dir, exist_ok=True)
set_seed(CFG.seed)

device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
